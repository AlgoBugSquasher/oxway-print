# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# print agent (Pi-only) — remote-update rollback state, must survive a
# `git reset --hard` on the Pi, so it must never be a tracked file.
.kiosk-update-state.json
# print agent (Pi-only) — a kiosk command's outcome, held locally when the
# Pi couldn't reach Supabase to report it, retried on the next poll tick.
.kiosk-command-result.json
