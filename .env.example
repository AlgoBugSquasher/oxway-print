# --- Payment gateway toggle -------------------------------------------------
# Flip this the moment either gateway's KYC is approved. No code changes needed.
# One of: cashfree | razorpay
PAYMENT_PROVIDER=razorpay

# --- Cashfree (KYC pending) ----------------------------------------------
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
# Optional, only needed if you wire up the webhook. Falls back to CASHFREE_SECRET_KEY.
CASHFREE_WEBHOOK_SECRET=
# "sandbox" (default) or "production"
CASHFREE_ENV=sandbox

# --- Razorpay ------------------------------------------------------------
# Safe to expose to the browser — it's the public key id, not the secret.
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Optional, only needed if you wire up the webhook.
RAZORPAY_WEBHOOK_SECRET=

# --- Printer (set on the Pi's .env.local, not the website's) -----------------
# CUPS printer name, e.g. from `lpstat -p`. Leave blank to use the system default.
PRINTER_NAME=
# Which physical kiosk this Pi is (Pi-side only). Defaults to "oxway_01" —
# only set this when adding a second+ kiosk.
KIOSK_ID=oxway_01
# How often the Pi's print agent polls Supabase for newly-paid jobs, in ms.
PRINT_AGENT_POLL_INTERVAL_MS=4000

# --- Supabase (shared by the website and the Pi's print agent) ---------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret — server-side only (website API routes + Pi print agent), never the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Storage bucket final print-ready PDFs are uploaded to. Defaults to "print-jobs".
SUPABASE_PRINT_BUCKET=print-jobs

# --- Misc ----------------------------------------------------------------
# Only needed if you wire up gateway webhooks (return_url/notify_url).
NEXT_PUBLIC_BASE_URL=http://localhost:3000
# How long a checkout session stays open before the kiosk gives up, in seconds.
PAYMENT_TIMEOUT_SECONDS=300
# Shared secret for /api/cron/recheck-payments and /api/cron/check-kiosk-heartbeats.
# Generate a fresh random value per deployment — never reuse one from another
# project's docs/history. Set the same value on your external scheduler
# (cron-job.org) once you point it at the deployed URL. Leave blank only for
# local testing; those routes run unprotected if unset.
CRON_SECRET=
# Where low-supply / kiosk-silent alerts would go once ROADMAP.md #2 is
# re-enabled — the owner's phone number, 10 digits. Unused while #2 is
# disabled; alerts just log to the console / show as admin dashboard badges.
OWNER_ALERT_PHONE=

# --- Prototype-only quick login (ROADMAP.md #26) --------------------------
# Set to "true" to show the passcode shortcuts on /admin/login, alongside the
# real email/password form. Each passcode maps to a real Supabase Auth
# account's real credentials below — this is a UI convenience, not a second
# auth system. Deleting this whole block (and the UI it gates) is the entire
# removal step later.
NEXT_PUBLIC_PROTOTYPE_MODE=false
PROTOTYPE_OWNER_PASSCODE=
PROTOTYPE_OWNER_EMAIL=
PROTOTYPE_OWNER_PASSWORD=
PROTOTYPE_STAFF_PASSCODE=
PROTOTYPE_STAFF_EMAIL=
PROTOTYPE_STAFF_PASSWORD=
